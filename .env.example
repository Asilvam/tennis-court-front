# Valores activos sugeridos para local; Prod indica el valor para Heroku.
# VITE_* es publico: nunca poner tokens ni secretos en este archivo.
# Reiniciar Vite o recompilar despues de cambiar estas variables.
# Front publico: https://ctq.serviciosasm.cl (React sigue alojado en Heroku).
# El dominio se configura en Heroku y DNS de Cloudflare, no en una variable VITE.
# La etapa DNS/HTTPS no cambia VITE_API_URL ni agrega secretos o variables.
# Etapa 2: reset y retornos de pago usan ctq.serviciosasm.cl en sus servicios;
# VITE_API_URL sigue apuntando a la API de Heroku. No duplicar esas URLs aqui.

# Razon: direccion del backend que utiliza el navegador.
# Local: http://localhost:3500
# Prod: https://app-tenis-qtro-backend-2-dc5629e092b9.herokuapp.com
VITE_API_URL=http://localhost:3500

# Los permisos y la habilitacion de pagos los determina el backend.
# No se necesitan banderas VITE de mensualidades.
